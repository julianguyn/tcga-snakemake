import re
from pathlib import Path

from snakemake.exceptions import WorkflowError


configfile: "config/config.yaml"


SUPPORTED_PROFILES = (
    "simple_nucleotide_variation",
    "copy_number_variation",
    "gene_expression",
    "dna_methylation",
    "protein_profiling",
    "clinical",
)


def config_list(key):
    values = config.get(key, [])
    if values is None:
        return []
    if isinstance(values, str):
        values = [values]
    if not isinstance(values, list):
        raise WorkflowError(f"Config key '{key}' must be a string or list of strings.")

    cleaned = [str(value).strip() for value in values if str(value).strip()]
    return cleaned


PROJECTS = config_list("projects") or config_list("project")
PROFILES = config_list("profiles")

if not PROJECTS:
    raise WorkflowError("Config must define at least one TCGA project under 'projects'.")

if not PROFILES:
    raise WorkflowError("Config must define at least one profile under 'profiles'.")

unknown_profiles = sorted(set(PROFILES) - set(SUPPORTED_PROFILES))
if unknown_profiles:
    raise WorkflowError(
        "Unsupported profiles in config: "
        + ", ".join(unknown_profiles)
        + ". Supported profiles are: "
        + ", ".join(sorted(SUPPORTED_PROFILES))
    )

PROJECT_PATTERN = "|".join(re.escape(project) for project in PROJECTS)
PROFILE_PATTERN = "|".join(re.escape(profile) for profile in PROFILES)


def resolve_samples_file(project):
    project_specific = Path("config") / "samples" / f"{project}.txt"
    shared = Path("config") / "samples.txt"

    if project_specific.exists():
        return str(project_specific)
    if shared.exists():
        return str(shared)

    return ""


def profile_output(project, profile):
    return f"data/procdata/{project}/{profile}.RDS"


def mae_inputs(wildcards):
    return [profile_output(wildcards.project, profile) for profile in PROFILES]


rule all:
    input:
        expand("data/results/{project}_MAE.RDS", project=PROJECTS)


rule download_profile:
    output:
        profile="data/procdata/{project}/{profile}.RDS"
    log:
        "logs/{project}/{profile}.log"
    params:
        sample_file=lambda wildcards: resolve_samples_file(wildcards.project),
    threads: 1
    wildcard_constraints:
        project=PROJECT_PATTERN,
        profile=PROFILE_PATTERN,
    script:
        "scripts/download_profile.R"


rule get_mae:
    input:
        mae_inputs
    output:
        mae="data/results/{project}_MAE.RDS"
    log:
        "logs/{project}/get_mae.log"
    threads: 1
    wildcard_constraints:
        project=PROJECT_PATTERN,
    script:
        "scripts/get_MAE.R"
